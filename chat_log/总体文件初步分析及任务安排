先做文本清洗脚本
最重要的是：

统一编码 UTF-8
去掉页眉页脚
去掉说明性注释行
去掉重复空行
处理乱码字符
抽取标题和正文
示例 Python 脚本：

蟒蛇
import os
import re
import json
from pathlib import Path

ROOT = Path("raw_corpus")
OUT = Path("processed_corpus")

def clean_text(text: str) -> str:
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    text = text.replace("\uFFFD", "")
    text = re.sub(r"\n{3,}", "\n\n", text)
    text = re.sub(r" +", " ", text)
    text = re.sub(r"\n +", "\n", text)

    # 去除常见说明性注释行
    lines = []
    for line in text.split("\n"):
        s = line.strip()
        if not s:
            continue
        if s.startswith("#"):
            continue
        if s.startswith(">"):
            continue
        if "说明：" in s and "raw_corpus" in s:
            continue
        lines.append(s)
    return "\n".join(lines).strip()

def extract_title_and_body(text: str):
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    title = lines[0] if lines else ""
    body = "\n".join(lines[1:]) if len(lines) > 1 else ""
    return title, body

def process_file(path: Path):
    try:
        text = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        text = path.read_text(encoding="gbk", errors="ignore")

    cleaned = clean_text(text)
    title, body = extract_title_and_body(cleaned)

    record = {
        "id": path.stem,
        "title": title,
        "source_file": str(path),
        "type": "unknown",
        "text": body
    }
    return record

def main():
    OUT.mkdir(exist_ok=True)
    files = sorted(ROOT.iterdir())
    dataset = []

    for p in files:
        if p.is_file():
            rec = process_file(p)
            dataset.append(rec)

    out_file = OUT / "corpus.json"
    with open(out_file, "w", encoding="utf-8") as f:
        json.dump(dataset, f, ensure_ascii=False, indent=2)

    print(f"processed {len(dataset)} files")

if __name__ == "__main__":
    main()
